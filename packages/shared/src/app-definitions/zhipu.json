{
  "schemaVersion": 1,
  "slug": "zhipu",
  "name": "Zhipu GLM",
  "description": "Zhipu GLM models through the OpenAI-compatible BigModel API.",
  "categories": [
    "ai"
  ],
  "tags": [
    "model-provider"
  ],
  "branding": {
    "logoUrl": "/brands/apps/zhipu.svg"
  },
  "urlPatterns": [
    "https://open.bigmodel.cn/*"
  ],
  "docsUrl": "https://docs.bigmodel.cn/cn/guide/develop/openai/introduction",
  "methods": [
    {
      "key": "ai-api_key",
      "label": "Zhipu GLM API key",
      "purpose": "ai",
      "transport": "runtime_auth",
      "auth": "api_key",
      "ai": {
        "provider": "openai",
        "method": "api_key",
        "vendorPresetId": "zhipu",
        "routing": {
          "kind": "gateway",
          "protocol": "chat",
          "auth": "bearer",
          "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
          "models": [
            {
              "id": "glm-5.3",
              "label": "GLM-5.3"
            },
            {
              "id": "glm-5.2",
              "label": "GLM-5.2"
            },
            {
              "id": "glm-4.7",
              "label": "GLM-4.7"
            }
          ]
        }
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "Run an AI SDK agent using your authorized Zhipu GLM account.",
      "guidanceMd": "Create an API key on the Zhipu open platform. Use the documented OpenAI-compatible base URL and GLM model IDs.",
      "riskTier": "S3",
      "credentialFields": [
        {
          "key": "apiKey",
          "label": "API key",
          "type": "password",
          "required": true,
          "placeholder": "Enter Zhipu API key",
          "secret": true
        }
      ],
      "keyPlacement": {
        "location": "env",
        "name": "PAPERCLIP_AI_PROVIDER_KEY"
      },
      "consoleLinks": {
        "keys": "https://open.bigmodel.cn/usercenter/apikeys",
        "docs": "https://docs.bigmodel.cn/cn/guide/develop/openai/introduction"
      }
    }
  ]
}
