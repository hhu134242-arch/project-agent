{
  "schemaVersion": 1,
  "slug": "hunyuan",
  "name": "Tencent Hunyuan",
  "description": "Tencent Hunyuan models via the OpenAI-compatible API.",
  "categories": [
    "ai"
  ],
  "tags": [
    "model-provider"
  ],
  "branding": {
    "logoUrl": "/brands/apps/hunyuan.svg"
  },
  "urlPatterns": [
    "https://api.hunyuan.cloud.tencent.com/*"
  ],
  "docsUrl": "https://cloud.tencent.com/document/product/1729/111007",
  "methods": [
    {
      "key": "ai-api_key",
      "label": "Tencent Hunyuan API key",
      "purpose": "ai",
      "transport": "runtime_auth",
      "auth": "api_key",
      "ai": {
        "provider": "openai",
        "method": "api_key",
        "vendorPresetId": "hunyuan",
        "routing": {
          "kind": "gateway",
          "protocol": "chat",
          "auth": "bearer",
          "baseUrl": "https://api.hunyuan.cloud.tencent.com/v1",
          "models": [
            {
              "id": "hunyuan-turbos-latest",
              "label": "Hunyuan TurboS Latest"
            },
            {
              "id": "hunyuan-turbo",
              "label": "Hunyuan Turbo"
            },
            {
              "id": "hunyuan-pro",
              "label": "Hunyuan Pro"
            }
          ]
        }
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "Run an AI SDK agent using your authorized Tencent Hunyuan account.",
      "guidanceMd": "Create a Hunyuan API key in the Tencent Cloud console. Use the OpenAI-compatible base URL and Hunyuan model names from the product docs.",
      "riskTier": "S3",
      "credentialFields": [
        {
          "key": "apiKey",
          "label": "API key",
          "type": "password",
          "required": true,
          "placeholder": "Enter Hunyuan API key",
          "secret": true
        }
      ],
      "keyPlacement": {
        "location": "env",
        "name": "PAPERCLIP_AI_PROVIDER_KEY"
      },
      "consoleLinks": {
        "keys": "https://console.cloud.tencent.com/hunyuan/api-key",
        "docs": "https://cloud.tencent.com/document/product/1729/111007"
      }
    }
  ]
}
